{
  "schemaVersion": 1,
  "id": "lookup-savings-balance",
  "version": "1.0.0",
  "description": "Look up the member and return the savings account balance and currency. Verify that the member ID matches the input.",
  "application": {
    "family": "ledger-demo",
    "version": "1",
    "surface": "web",
    "entryPath": "/sandbox/"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "description": "Invocation parameter: memberId",
      "sensitive": true
    }
  },
  "outputs": {
    "balance": {
      "type": "string",
      "description": "Extracted using money validation",
      "sensitive": true
    },
    "currency": {
      "type": "string",
      "description": "Extracted using text validation",
      "sensitive": false
    }
  },
  "steps": [
    {
      "type": "fill",
      "target": {
        "by": "role",
        "role": "textbox",
        "name": "Member ID",
        "frame": "Member workspace"
      },
      "value": {
        "input": "memberId"
      },
      "reason": "Enter the member ID to search"
    },
    {
      "type": "click",
      "target": {
        "by": "role",
        "role": "button",
        "name": "Search",
        "frame": "Member workspace"
      },
      "reason": "Search for the member"
    },
    {
      "type": "click",
      "target": {
        "by": "role",
        "role": "link",
        "name": "Open member",
        "frame": "Member workspace"
      },
      "reason": "Activate the link to open the member"
    },
    {
      "type": "click",
      "target": {
        "by": "role",
        "role": "link",
        "name": "View accounts",
        "frame": "Member workspace"
      },
      "reason": "View the member accounts"
    },
    {
      "type": "read",
      "target": {
        "by": "tableCell",
        "row": "Savings",
        "column": "Available balance",
        "frame": "Member workspace"
      },
      "output": "balance",
      "format": "money",
      "sensitive": true,
      "reason": "Extract the sensitive savings account balance"
    },
    {
      "type": "read",
      "target": {
        "by": "tableCell",
        "row": "Savings",
        "column": "Currency",
        "frame": "Member workspace"
      },
      "output": "currency",
      "format": "text",
      "sensitive": false,
      "reason": "Extract the savings account currency"
    },
    {
      "type": "checkpoint",
      "target": {
        "by": "tableCell",
        "row": "Member ID",
        "column": "Value",
        "frame": "Member workspace"
      },
      "expect": "equals",
      "value": {
        "input": "memberId"
      },
      "reason": "Verify the final account page member ID matches the input"
    }
  ],
  "outcomes": [
    {
      "text": "Invalid member ID",
      "code": "INVALID_MEMBER_ID",
      "kind": "business",
      "recovery": "none"
    },
    {
      "text": "No matching member",
      "code": "MEMBER_NOT_FOUND",
      "kind": "business",
      "recovery": "none"
    },
    {
      "text": "Access denied",
      "code": "ACCESS_DENIED",
      "kind": "business",
      "recovery": "none"
    },
    {
      "text": "Temporarily unavailable",
      "code": "TRANSIENT_LOAD",
      "kind": "retry",
      "recovery": "reload"
    },
    {
      "text": "Session expired",
      "code": "SESSION_EXPIRED",
      "kind": "handoff",
      "recovery": "none"
    },
    {
      "text": "Service failed",
      "code": "APP_ERROR",
      "kind": "failure",
      "recovery": "none"
    }
  ],
  "provenance": {
    "runId": "cff8a934-d24e-4198-b50d-30207682851f",
    "backend": "codex",
    "model": "gpt-6-astra",
    "recordedAt": "2026-09-12T06:07:43.894Z",
    "artifactHash": "69e7bebf68e6755b40304d3e338c2a2c3e806d40883b27f501b3bc6c3ba5941f"
  }
}
